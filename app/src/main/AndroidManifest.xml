<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 2.10: lets PlayGamesSyncManager notice when connectivity returns so offline achievement
         unlocks reach Play Games. Normal permission; reads network state only, no data collected. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- D8: every user is treated as child-directed, so the advertising ID is never used.
         play-services-ads merges this permission in; strip it from the final manifest. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <!-- D8: no Privacy Sandbox ad ID, attribution or topics for a child-directed audience. -->
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_TOPICS"
        tools:node="remove" />

    <application
        android:name=".GeographyQuizApplication"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GeographyQuiz">

        <meta-data
            android:name="com.google.android.gms.games.APP_ID"
            android:value="@string/play_games_app_id" />

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/admob_app_id" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustPan"
            android:theme="@style/Theme.GeographyQuiz">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geoquiz" android:host="challenge" />
            </intent-filter>
            <!-- Verified App Link for shared challenge URLs (/challenge.html and /challenge).
                 Verification needs docs/.well-known/assetlinks.json on the host to list this
                 package's signing certificate. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="geoquiz-app.netlify.app" />
                <data android:pathPrefix="/challenge" />
            </intent-filter>
        </activity>
    </application>

</manifest>
